# Copy to .env next to docker-compose and edit. Never commit the real .env.

# ---- Admin panel login (REQUIRED) ----
# The panel lives at http://<host>:<port>/refused
REFUSED_USERNAME=admin
REFUSED_PASSWORD=CHANGE_ME

# ---- Connection ----
# Where Remux is reachable from inside this container. Use the service name
# and Remux's internal port if both share a compose network, otherwise the
# host's LAN IP and the published Remux port.
REMUX_URL=http://remux:3000

# ---- Optional ----
# Seconds before an ordinary upstream request gives up.
REQUEST_TIMEOUT=30
# Admin sign-in lifetime in hours.
SESSION_HOURS=12
# Set true only if you put the panel behind HTTPS.
COOKIE_SECURE=false
# Starting state of each module on the very first run only. After that the
# panel's switches win.
STREAM_STRIP_DEFAULT=false
POSTER_REFRESH_DEFAULT=false
SEE_ALL_DEFAULT=false
SEARCH_CLEAN_DEFAULT=false
DIAGNOSTICS_DEFAULT=false
LOG_LEVEL=INFO
